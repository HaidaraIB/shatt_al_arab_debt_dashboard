{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Application user with role-based access (admin, supervisor, or lawyer).",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["admin", "lawyer", "supervisor"] },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "lawyerName": { "type": "string", "description": "Required for lawyers; must match customers.lawyerName" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["role", "email", "active"]
    },
    "Customer": {
      "title": "Customer",
      "description": "A late-paying customer for Zone 1 of Shatt al-Arab Residential City.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "unitNumber": { "type": "string" },
        "delayedInstallments": { "type": "number" },
        "remainingBalance": { "type": "number" },
        "lastInstallmentDate": { "type": "string", "format": "date" },
        "lastInstallmentAmount": { "type": "number" },
        "legalStatus": {
          "type": "string",
          "description": "Built-in: none, notified, warned, lawsuit; admins may add more via config/statuses"
        },
        "lawyerName": { "type": "string" },
        "lastContactNotes": { "type": "string" },
        "statusHistory": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "status": { "type": "string" },
              "notes": { "type": "string" },
              "updatedBy": { "type": "string" },
              "timestamp": { "type": "string", "format": "date-time" }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "phone", "unitNumber", "delayedInstallments", "remainingBalance", "legalStatus"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Payment record under a customer (admin-only writes).",
      "type": "object",
      "properties": {
        "amount": { "type": "number" },
        "paidAt": { "type": "string", "format": "date" },
        "notes": { "type": "string" },
        "recordedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["amount", "paidAt", "recordedBy"]
    }
  },
  "firestore": {
    "users": {
      "schema": "UserProfile",
      "description": "Authorized users and roles"
    },
    "customers": {
      "schema": "Customer",
      "description": "Collection of late-paying customers"
    },
    "customers/{id}/payments": {
      "schema": "Payment",
      "description": "Payment ledger per customer"
    },
    "config": {
      "schema": "object",
      "description": "Global configuration (lawyers list, status options, access bootstrap)"
    }
  },
  "rbac": {
    "admin": ["customers CRUD", "payments create", "config write"],
    "supervisor": ["customers read all", "customers create and update", "read all payments"],
    "lawyer": ["read assigned customers", "update legalStatus and notes only", "read payments on assigned customers"]
  }
}
